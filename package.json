{
  "name": "catchup-ai",
  "version": "0.2.0",
  "private": true,
  "description": "CatchUp AI: evidence-grounded, feasibility-aware, approval-gated learning recovery",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "eval": "vitest run --project eval",
    "db:start": "node scripts/ensure-signing-key.mjs && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "fixtures:pdf": "tsx scripts/make-fixture-pdfs.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@openai/agents": "0.21.0",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "openai": "^7.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
