# Copy to .env.local (local) or set in your host's environment (production). Never commit real values.
# Local development: `npm run db:start`, then copy values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used only by trusted server pipelines after ownership checks.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# A function-calling model available to your OpenAI project (copilot + live evaluation).
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: reasoning effort for OpenAI reasoning models (minimal|low|medium|high). Responses are never stored at OpenAI.
OPENAI_REASONING_EFFORT=
# Optional: a second OpenAI model, tried once when the first hits its quota, is overloaded or times out. Must differ
# from OPENAI_MODEL.
OPENAI_FALLBACK_MODEL=
# After changing the embedding model, re-embed stored documents once with scripts/reembed-documents.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# One-click demo protection (Cloudflare Turnstile). The SECRET goes into Supabase Auth > Attack protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/cleanup-demo. Use a long random string.
CRON_SECRET=
# Local Mailpit (sign-in codes) — E2E tests only.
MAILPIT_URL=http://127.0.0.1:54324

# Optional: override the vector-similarity bar for evidence (default 0.3).
EVIDENCE_VECTOR_THRESHOLD=
# Optional AI faithfulness judge: one extra model request per answer re-checks each cited fact that passed the
# word check and removes the ones it rejects. Off unless "on". FAITHFULNESS_JUDGE_MODEL defaults to the chat model.
FAITHFULNESS_JUDGE=
FAITHFULNESS_JUDGE_MODEL=
# Scanned PDFs (no selectable text) are read by the OpenAI model when OPENAI_API_KEY and OPENAI_MODEL are set (needs
# migration 0021): one model request per scan, up to 20 pages, counted towards the student's daily copilot limit and
# the daily token budget. PDF_OCR=off turns it off. OPENAI_OCR_MODEL (optional, must read PDFs) defaults to OPENAI_MODEL.
PDF_OCR=
OPENAI_OCR_MODEL=

# Opt-in study emails (server only). Locally, NUDGE_TRANSPORT=json captures mail instead of sending it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Organisation billing (Stripe TEST mode). Billing stays off unless all three are set; live keys are refused
# unless STRIPE_ALLOW_LIVE=1. Enter them through a hidden prompt / the Vercel dashboard, never in chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASS=
# Optional: seats on the Class plan (default 300) and the price text shown on /pricing (must match Stripe).
STRIPE_CLASS_SEATS=
STRIPE_PRICE_CLASS_LABEL=
