# Copy to .env.local. Never commit real values.
# Local development: run `npm run db:start`, then copy values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used only by trusted server pipelines (ingestion, run/proposal writes)
# after ownership checks. Never expose to the browser or to agent tools.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# A function-calling model available to your OpenAI project (required for the copilot and quizzes).
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local Mailpit (sign-in codes) — used by E2E tests only.
MAILPIT_URL=http://127.0.0.1:54324
