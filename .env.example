# Copy to .env.local (local) or set in your host's environment (production). Never commit real values.
# Local development: `npm run db:start`, then copy values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Used only by trusted server pipelines after ownership checks.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# A function-calling model available to your OpenAI project (copilot + live evaluation).
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXT_PUBLIC_APP_URL=http://localhost:3000
# One-click demo protection (Cloudflare Turnstile). The SECRET goes into Supabase Auth > Attack protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/cleanup-demo. Use a long random string.
CRON_SECRET=
# Local Mailpit (sign-in codes) — E2E tests only.
MAILPIT_URL=http://127.0.0.1:54324

# Live AI on the Gemini free tier (alternative to OpenAI). AI_PROVIDER=gemini|openai picks one explicitly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional second model, tried once when the first hits its daily quota, is overloaded or times out.
# It has its own free daily quota. Must differ from GEMINI_MODEL. (OPENAI_FALLBACK_MODEL works the same way.)
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_PROVIDER=
# Optional: override the vector-similarity bar for evidence (default 0.6 for Gemini, 0.3 for OpenAI).
EVIDENCE_VECTOR_THRESHOLD=

# Opt-in study emails (server only). Locally, NUDGE_TRANSPORT=json captures mail instead of sending it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
